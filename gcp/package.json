{
  "name": "@globalstack/gcp",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated GlobalStack GCP emulator workspace.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-credentials.mjs --adc",
    "coverage": "node scripts/fetch-coverage.mjs",
    "start": "node src/cli/globalstack-gcp.mjs",
    "sweep": "node scripts/cleanup/sweep-real-gcp.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "validate": "node --check scripts/check-credentials.mjs && node --check scripts/fetch-coverage.mjs && node --check scripts/cleanup/sweep-real-gcp.mjs && node --test tests/**/*.test.mjs"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}

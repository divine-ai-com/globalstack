FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PLATFORM_ID=azure-terraform-hcl
ENV AZURE_LOCATION=eastus

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git jq unzip gnupg lsb-release python3 python3-pip python3-venv build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://aka.ms/InstallAzureCLIDeb | bash
RUN install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /etc/apt/keyrings/hashicorp.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/hashicorp.list \
    && apt-get update && apt-get install -y --no-install-recommends terraform \
    && rm -rf /var/lib/apt/lists/*

COPY common/globalstack-azure.sh /opt/globalstack/globalstack-azure.sh
COPY common/entrypoint.sh /entrypoint.sh
COPY stages /opt/globalstack/stages
RUN chmod +x /entrypoint.sh /opt/globalstack/globalstack-azure.sh /opt/globalstack/stages/*/*.sh

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]

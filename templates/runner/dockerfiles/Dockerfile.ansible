FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PLATFORM_ID=azure-ansible-yaml
ENV AZURE_LOCATION=eastus

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git jq unzip gnupg lsb-release python3 python3-pip python3-venv build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://aka.ms/InstallAzureCLIDeb | bash
RUN python3 -m pip install --no-cache-dir --break-system-packages ansible \
    && ansible-galaxy collection install azure.azcollection \
    && AZURE_COLLECTION_REQUIREMENTS="$(find /usr/local/lib /root/.ansible/collections -path '*/ansible_collections/azure/azcollection/requirements.txt' -print -quit)" \
    && test -n "${AZURE_COLLECTION_REQUIREMENTS}" \
    && python3 -m pip install --no-cache-dir --break-system-packages -r "${AZURE_COLLECTION_REQUIREMENTS}"

COPY common/globalstack-azure.sh /opt/globalstack/globalstack-azure.sh
COPY common/entrypoint.sh /entrypoint.sh
COPY stages /opt/globalstack/stages
RUN chmod +x /entrypoint.sh /opt/globalstack/globalstack-azure.sh /opt/globalstack/stages/*/*.sh

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]

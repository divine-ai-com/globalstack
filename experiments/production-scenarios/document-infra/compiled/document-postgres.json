{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "3574208768556269524"
    }
  },
  "parameters": {
    "serviceName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "administratorObjectId": {
      "type": "string"
    },
    "administratorName": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}-db', parameters('serviceName'))]",
      "location": "[parameters('location')]",
      "tags": {
        "project": "globalstack-production-scenarios",
        "run": "[parameters('runId')]"
      },
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "authConfig": {
          "activeDirectoryAuth": "Enabled",
          "passwordAuth": "Disabled",
          "tenantId": "[parameters('tenantId')]"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/administrators",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-db', parameters('serviceName')), parameters('administratorObjectId'))]",
      "properties": {
        "principalName": "[parameters('administratorName')]",
        "principalType": "ServicePrincipal",
        "tenantId": "[parameters('tenantId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', parameters('serviceName')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-db', parameters('serviceName')), 'documents')]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', parameters('serviceName')))]"
      ]
    }
  ],
  "outputs": {
    "databaseHost": {
      "type": "string",
      "value": "[format('{0}.postgres.database.azure.com', format('{0}-db', parameters('serviceName')))]"
    },
    "databaseName": {
      "type": "string",
      "value": "documents"
    },
    "serverId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', parameters('serviceName')))]"
    }
  }
}
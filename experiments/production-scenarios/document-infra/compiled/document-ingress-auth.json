{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "3383205780379839848"
    }
  },
  "parameters": {
    "ingressName": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "apiAudience": {
      "type": "string"
    },
    "allowedClientId": {
      "type": "string"
    },
    "allowedPrincipalId": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', parameters('ingressName'), 'current')]",
      "properties": {
        "platform": {
          "enabled": true
        },
        "globalValidation": {
          "unauthenticatedClientAction": "Return401"
        },
        "httpSettings": {
          "requireHttps": true
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "registration": {
              "clientId": "[parameters('apiAudience')]",
              "openIdIssuer": "[uri(environment().authentication.loginEndpoint, format('{0}/v2.0', parameters('tenantId')))]"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('apiAudience')]",
                "[format('api://{0}', parameters('apiAudience'))]"
              ],
              "defaultAuthorizationPolicy": {
                "allowedApplications": [
                  "[parameters('allowedClientId')]"
                ],
                "allowedPrincipals": {
                  "identities": [
                    "[parameters('allowedPrincipalId')]"
                  ]
                }
              },
              "jwtClaimChecks": {
                "allowedClientApplications": [
                  "[parameters('allowedClientId')]"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "authenticationId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/containerApps/authConfigs', parameters('ingressName'), 'current')]"
    }
  }
}
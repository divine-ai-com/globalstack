{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "12275626092600211641"
    }
  },
  "parameters": {
    "runId": {
      "type": "string",
      "defaultValue": ""
    },
    "scannerName": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "scannerAudience": {
      "type": "string"
    },
    "workerIdentityName": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', parameters('scannerName'), 'current')]",
      "properties": {
        "platform": {
          "enabled": true
        },
        "globalValidation": {
          "unauthenticatedClientAction": "Return401"
        },
        "httpSettings": {
          "requireHttps": true
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "registration": {
              "clientId": "[parameters('scannerAudience')]",
              "openIdIssuer": "[uri(environment().authentication.loginEndpoint, format('{0}/v2.0', parameters('tenantId')))]"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('scannerAudience')]"
              ],
              "defaultAuthorizationPolicy": {
                "allowedApplications": [
                  "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('workerIdentityName')), '2023-01-31').clientId]"
                ],
                "allowedPrincipals": {
                  "identities": [
                    "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('workerIdentityName')), '2023-01-31').principalId]"
                  ]
                }
              },
              "jwtClaimChecks": {
                "allowedClientApplications": [
                  "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('workerIdentityName')), '2023-01-31').clientId]"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "authenticationId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/containerApps/authConfigs', parameters('scannerName'), 'current')]"
    },
    "evidenceRunId": {
      "type": "string",
      "value": "[parameters('runId')]"
    }
  }
}